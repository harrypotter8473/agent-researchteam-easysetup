# Mattermost settings — append to the profile's .env on each device:
#   ~/.hermes/profiles/<profile>/.env
# One bot account per agent (System Console → Integrations → Bot Accounts), each added to
# the team and to every paper channel.

# ── Every profile ─────────────────────────────────────────────────────────────
# The runner (research_board.py run) posts progress as this bot; research-lead uses it for
# `research_board.py setup/thread`; a gateway, where one runs, uses it to chat.
MATTERMOST_URL=https://mm.example.com
MATTERMOST_TOKEN=<this agent's bot token>

# ── Only profiles that run a gateway (`<profile> gateway start`) ──────────────
#   research-lead            always — this is how you talk to the team
#   research-writer-chat     optional — co-writing in a DM
#   research-librarian-chat   optional — one-off literature questions
# Never start a gateway on research-writer / research-reviewer / research-librarian themselves: their
# runner already uses that profile, and two agent processes must not share one profile.
MATTERMOST_ALLOWED_USERS=<your Mattermost user id>   # only you can command the bots; other bots are ignored
MATTERMOST_REPLY_MODE=thread                          # each request gets its own thread and session
MATTERMOST_REQUIRE_MENTION=true                       # in channels, the bot answers only when @mentioned
# MATTERMOST_HOME_CHANNEL=<channel id>                # optional: where the gateway posts its own notices
