#!/usr/bin/env python3
"""Manifest-verified research entry point with inspectable gateway argv.

The installer supplies the already-validated Hermes install root. Its official
bootstrap still selects/leases dependencies; no PYTHONPATH or cwd imports.
"""
import os
from pathlib import Path
import sys

root = Path(os.environ['RESEARCH_HERMES_INSTALL']).resolve()
if not (root / 'hermes_cli/main.py').is_file() or not (root / 'hermes_bootstrap.py').is_file():
    raise SystemExit('Validated Hermes installation no longer exists')
sys.path.insert(0, str(root))
import hermes_bootstrap
from hermes_cli.main import main
main()
