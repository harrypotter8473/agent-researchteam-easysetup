<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NST Research Team Setup — 1인 연구실" Width="1060" Height="850" MinWidth="960" MinHeight="740"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI, Malgun Gothic" FontSize="14" Background="#F5F7FB">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8,5"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="NST · 내 PC에 만드는 1인 연구실" FontSize="28" FontWeight="SemiBold" Foreground="#172A4A"/>
      <TextBlock Text="Mattermost 로컬 서버 + Hermes + 논문·보고서 연구팀 4개 역할" Margin="0,6,0,0" Foreground="#56657D"/>
    </StackPanel>
    <TabControl x:Name="WizardTabs" Grid.Row="1">
      <TabItem x:Name="ServerTab" Header="1. 로컬 서버">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="이 PC에서 Mattermost 서버와 관리자 계정을 만듭니다." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Docker Desktop의 Linux 엔진이 필요합니다. 기본 주소는 http://127.0.0.1:18065 입니다." TextWrapping="Wrap" Margin="0,10,0,16"/>
          <WrapPanel><Button x:Name="DockerCheckButton" Content="Docker 준비 다시 확인"/><Button x:Name="DockerOpenButton" Content="Docker Desktop 열기" IsEnabled="False"/><Button x:Name="ServerRestoreButton" Content="기존 연구 서버 불러오기"/></WrapPanel>
          <TextBlock x:Name="DockerStatus" Text="설치 위치·공식 서명·Linux 엔진과 PC 준비 상태를 확인합니다." Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBlock x:Name="DockerPrerequisites" TextWrapping="Wrap" Foreground="#56657D" Margin="0,0,0,10"/>
          <Border Background="#EDF2FB" Padding="12" CornerRadius="4" Margin="0,0,0,10"><StackPanel>
            <CheckBox x:Name="DockerInstallConsent" IsEnabled="False"><TextBlock Text="미설치 시 공식 Docker Desktop을 다운로드·검증하고 사용자별 설치를 시작하는 데 동의합니다. 약관은 Docker에서 직접 확인하며, Windows 기능 설정·재부팅은 별도 안내에 따릅니다." TextWrapping="Wrap"/></CheckBox>
            <WrapPanel Margin="0,10,0,0"><Button x:Name="DockerInstallButton" Content="공식 Docker 다운로드·설치" IsEnabled="False"/><Button x:Name="DockerGuideButton" Content="공식 설치·약관 안내"/></WrapPanel>
          </StackPanel></Border>
          <Expander Header="Docker를 사용할 수 없다면?" Margin="0,0,0,16"><TextBlock x:Name="DockerAlternatives" Text="WSL2가 가능하면 Ubuntu 내부 직접 설치를 별도 개발할 수 있습니다. 가상화도 불가하면 별도 Linux 서버 또는 기존 Mattermost 서버 연결이 대안입니다. 이 초기 버전에서는 대안 안내만 제공하며 조직 정책을 우회하지 않습니다." TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14"><TextBlock Text="서버 ID"/><TextBox x:Name="ServerId" Text="research-local" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="로컬 포트"/><TextBox x:Name="ServerPort" Text="18065" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="관리자 사용자 이름"/><TextBox x:Name="AdminUsername" Text="researcher" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="관리자 이메일"/><TextBox x:Name="AdminEmail" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="관리자 비밀번호 (12자 이상·대소문자·숫자·특수문자)"/><PasswordBox x:Name="AdminPassword" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="비밀번호 확인"/><PasswordBox x:Name="PasswordConfirm" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <CheckBox x:Name="ServerResumeCheck" Content="이 마법사에서 만든 같은 서버를 이어서 설정" Margin="0,16,0,10"/>
          <CheckBox x:Name="ServerConsent" Content="이 PC에 Mattermost·PostgreSQL 서버와 연구용 팀·채널을 생성하는 데 동의합니다." Margin="0,0,0,16"/>
          <WrapPanel><Button x:Name="ServerCreateButton" Content="로컬 서버 설치" IsEnabled="False"/><Button x:Name="ServerOpenButton" Content="내 연구실 열기" IsEnabled="False"/><Button x:Name="ServerNextButton" Content="다음: Hermes" IsEnabled="False"/></WrapPanel>
          <TextBlock x:Name="ServerStatus" TextWrapping="Wrap" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="HermesTab" Header="2. Hermes·모델" IsEnabled="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <TextBlock Text="Hermes를 설치합니다. Codex 직접 연결을 쓸 경우에만 모델 계정에 로그인합니다." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <CheckBox x:Name="UseExistingHermesCheck" Margin="0,14,0,8"><TextBlock Text="이 PC의 기존 Hermes를 선택해 사용합니다. 재설치·업데이트·새 로그인 없이 기존 인증과 프로필을 유지합니다. 선택한 로컬 설치의 코드를 실행하는 데 동의합니다." TextWrapping="Wrap"/></CheckBox>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="기존 Hermes 데이터 폴더 (HERMES_HOME)"/><TextBox x:Name="ExistingHermesHome" IsEnabled="False" Margin="0,5,0,0" AutomationProperties.Name="기존 Hermes 데이터 폴더"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="기존 Hermes 코드 폴더"/><TextBox x:Name="ExistingHermesInstallDir" IsEnabled="False" Margin="0,5,0,0" AutomationProperties.Name="기존 Hermes 코드 폴더"/></StackPanel>
          </Grid>
          <TextBlock x:Name="ExistingHermesStatus" Text="기존 설치가 있다면 위 항목을 선택하고 ‘기존 Hermes·인증 확인’을 누르세요. 새 연구 프로필만 추가하며 기존 프로필은 인수하지 않습니다." TextWrapping="Wrap" Foreground="#56657D"/>
          <WrapPanel Margin="0,16,0,12"><Button x:Name="HermesPlanButton" Content="PC 확인·설치 계획"/><Button x:Name="HermesStatusButton" Content="기존 Hermes·인증 확인"/></WrapPanel>
          <TextBox x:Name="HermesPlanText" Height="130" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Hermes 설치 계획"/>
          <CheckBox x:Name="HermesConsent" Content="표시된 계획에 따라 검증된 공식 Hermes 설치기를 실행하는 데 동의합니다." Margin="0,12,0,12"/>
          <Button x:Name="HermesInstallButton" Content="Hermes 설치" HorizontalAlignment="Left" IsEnabled="False"/>
          <Separator Margin="0,16,0,16"/>
          <WrapPanel><Button x:Name="AuthButton" Content="모델 계정 로그인" IsEnabled="False"/><Button x:Name="AuthOpenButton" Content="인증 페이지 열기" IsEnabled="False"/></WrapPanel>
          <TextBlock x:Name="AuthStatus" Text="Hermes 설치 또는 기존 설치 확인 뒤 로그인 상태를 확인합니다." Margin="0,12,0,8" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
          <TextBox x:Name="AuthCode" IsReadOnly="True" FontSize="20" AutomationProperties.Name="일회용 인증 코드"/>
          <TextBlock Text="Codex 모델 (‘Codex 직접 연결’을 쓸 때만 필요 — 모델 라우터를 쓰면 로그인 없이 다음으로 넘어가도 됩니다)" Margin="0,12,0,6" TextWrapping="Wrap"/>
          <ComboBox x:Name="ModelCombo" IsEnabled="False" MinHeight="32" AutomationProperties.Name="연구 에이전트 기본 모델"/>
          <Button x:Name="HermesNextButton" Content="다음: 에이전트 4개" HorizontalAlignment="Right" Margin="0,16,0,0" IsEnabled="False"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem x:Name="TeamTab" Header="3. 에이전트 4개" IsEnabled="False">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
          <Border x:Name="TeamQuickActions" Background="#EAF1FF" BorderBrush="#BED0F3" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <StackPanel>
              <WrapPanel><Button x:Name="TeamApplyButton" Content="기본설정 자동 구성 · 실제 설치 검증" FontWeight="SemiBold" Background="#245BBA" Foreground="White" IsEnabled="False"/><Button x:Name="TeamBoardButton" Content="Mattermost 작업보드 열기"/><Button x:Name="TeamOpenButton" Content="연구 채널 열기" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="Mattermost 왼쪽 ‘연구 작업보드’: 프로젝트·작업·문서·승인 요청·실시간 기록. 한국어 보드·NST 브랜딩 플러그인은 기본설정 과정에서 자동 설치됩니다." TextWrapping="Wrap" Margin="0,8,0,0"/>
              <WrapPanel><Button x:Name="TeamPluginsButton" Content="설치된 연구팀에 보드·NST만 연결 (S1 재실행 없음)"/></WrapPanel>
              <TextBlock Text="네 봇·토큰 → 전체 페르소나 → 개인 Gateway와 분리 → 독립 실행기 → 실제 S1·S2·S3 검증. 기존 서버·봇은 재사용하며, 검증을 통과하기 전에는 완료로 표시하지 않습니다." TextWrapping="Wrap" Margin="0,10,0,8"/>
              <TextBlock x:Name="QuickSetupSummary" TextWrapping="Wrap" Foreground="#334B6E" Margin="0,0,0,10"/>
              <DockPanel Margin="0,0,0,10"><TextBlock Text="관리자 비밀번호" VerticalAlignment="Center" Margin="0,0,12,0"/><PasswordBox x:Name="TeamAdminPassword" Width="250" HorizontalAlignment="Left" AutomationProperties.Name="봇 발급용 관리자 비밀번호"/><TextBlock Text="  1단계 입력은 이 창에서만 이어집니다." Foreground="#56657D" VerticalAlignment="Center"/></DockPanel>
              <CheckBox x:Name="ModelEgressConsent" Margin="0,0,0,6"><TextBlock Text="선택한 모델로 작업·논문 내용을 보내는 데 동의합니다. 실제 설치 검증은 모델 사용량을 소모합니다." TextWrapping="Wrap"/></CheckBox>
              <CheckBox x:Name="PublicWebConsent" Margin="0,0,0,6"><TextBlock Text="문헌 조사·인용 검증의 공개 웹 검색·원문 읽기를 허용합니다. 비공개 자료를 검색어로 보내지 않습니다." TextWrapping="Wrap"/></CheckBox>
              <CheckBox x:Name="TeamConsent"><TextBlock Text="위 설정으로 네 프로필·자동 실행 서비스와 보드·NST 플러그인을 구성하고, 실제 모델·봇으로 S1·S2·S3을 검증하는 데 동의합니다. 플러그인 적용 중 Mattermost가 잠시 재시작됩니다. 결과·감사·첨부 확인 전에는 사용 준비 완료로 표시하지 않습니다." TextWrapping="Wrap"/></CheckBox>
            </StackPanel>
          </Border>
          <Expander x:Name="TeamAdvancedSettings" Header="세부 설정 보기·변경 (역할·이름·토큰·모델·작업 폴더·실행 한도)" IsExpanded="False" Margin="0,0,0,10"><StackPanel Margin="0,12,0,0">
          <TextBlock Text="논문·보고서를 함께 쓰는 네 에이전트를 한 화면에서 설정합니다." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock Text="총괄이 사용자와 대화하며 작업 보드에 일을 나누고, 조사·분석/집필·감사 담당이 각자의 실행기에서 작업합니다. 심사와 감사는 작성 과정을 모르는 상태(블라인드)로 진행되며, 모든 결과는 작업한 버전(commit)과 함께 기록됩니다." TextWrapping="Wrap" Foreground="#56657D" Margin="0,6,0,0"/>
          <Grid Margin="0,12,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="로컬 Mattermost 주소"/><TextBox x:Name="TeamServerURL" Text="http://127.0.0.1:18065" IsReadOnly="True" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="연구 채널 ID"/><TextBox x:Name="HomeChannelID" IsReadOnly="True" Margin="0,5,0,0"/></StackPanel>
          </Grid>
          <TextBlock Text="기본설정 버튼이 네 봇·토큰을 자동 발급·연결합니다. 기존 발급 기록은 재사용합니다. 필요하면 이름과 고급 설정을 변경하세요." TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Grid x:Name="AgentRows" AutomationProperties.Name="연구 에이전트 네 개 설정"/>
          <Separator Margin="0,10,0,12"/>
          <TextBlock Text="모델 연결" FontSize="19" FontWeight="SemiBold"/>
          <RadioButton x:Name="ModelModeGateway" GroupName="ModelMode" Margin="0,8,0,4"><TextBlock Text="모델 라우터 (고급 선택) — API 키로 역할별 모델을 고르고, 논문의 공개 등급(public / private / air-gapped)에 따라 클라우드와 로컬 모델을 나눕니다. 로컬 모델이 없으면 비공개 논문은 실행하지 않고 이유를 알립니다." TextWrapping="Wrap"/></RadioButton>
          <Grid x:Name="GatewayPanel" Margin="24,4,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10"><TextBlock Text="Anthropic API 키 (Claude, 우선 사용)"/><PasswordBox x:Name="AnthropicKey" Margin="0,5,0,0" AutomationProperties.Name="Anthropic API 키"/></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="OpenAI API 키 (장애 시 대체, 또는 단독)"/><PasswordBox x:Name="OpenAIKey" Margin="0,5,0,0" AutomationProperties.Name="OpenAI API 키"/></StackPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="로컬 모델 주소 (선택, 예: http://127.0.0.1:8000/v1)"/><TextBox x:Name="LocalBaseURL" Margin="0,5,0,0" AutomationProperties.Name="로컬 모델 주소"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="로컬 모델 이름 (선택)"/><TextBox x:Name="LocalModel" Margin="0,5,0,0" AutomationProperties.Name="로컬 모델 이름"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="라우터 포트 (이 PC 안에서만 사용)"/><TextBox x:Name="GatewayPort" Text="18400" Margin="0,5,0,0" AutomationProperties.Name="모델 라우터 포트"/></StackPanel>
          </Grid>
          <RadioButton x:Name="ModelModeCodex" GroupName="ModelMode" IsChecked="True" Margin="0,4,0,4"><TextBlock Text="Codex 직접 연결 — 2단계에서 로그인한 ChatGPT/Codex 모델을 네 역할이 함께 씁니다. 공개(public) 논문·보고서만 처리합니다." TextWrapping="Wrap"/></RadioButton>
          <TextBlock x:Name="SelectedModelSummary" Text="Codex 모델: 2단계에서 로그인하면 선택할 수 있습니다." TextWrapping="Wrap" Margin="24,0,0,8" Foreground="#56657D"/>
          <Separator Margin="0,10,0,12"/>
          <TextBlock Text="작업 설정" FontSize="19" FontWeight="SemiBold"/>
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10"><TextBlock Text="작업 폴더 (논문·보고서·_template)"/><DockPanel Margin="0,5,0,0"><Button x:Name="WorkspaceBrowseButton" Content="찾기" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="WorkspacePath" AutomationProperties.Name="연구 작업 폴더"/></DockPanel></StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,0,10"><TextBlock Text="요청을 허용할 Mattermost 사용자 이름"/><TextBox x:Name="HumanUsername" Text="researcher" Margin="0,5,0,0" AutomationProperties.Name="허용할 연구자 사용자 이름"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="작업 하나의 시간 한도 (분, 30~720)"/><TextBox x:Name="TaskTimeoutMinutes" Text="180" Margin="0,5,0,0" AutomationProperties.Name="작업 시간 한도"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2"><TextBlock Text="동시에 심사하는 심사자 수 (1~3)"/><ComboBox x:Name="ReviewerSlots" MinHeight="32" Margin="0,5,0,0" AutomationProperties.Name="동시 심사자 수"/></StackPanel>
          </Grid>
          <TextBlock Text="기본 한도: Hermes 턴 2000/시도, 작업 시도 50회, 일시 모델 재시도 100회 (시간 한도 내). 작업 하나가 시간 한도를 넘으면 중단하고 스레드에 알립니다. 일시적인 모델 오류는 자동으로 다시 시도합니다. 원고 PDF를 만들려면 이 PC에 TeX(MiKTeX 또는 TeX Live)가 있어야 합니다. 없으면 집필 작업이 이유와 함께 보류됩니다." TextWrapping="Wrap" Foreground="#56657D" Margin="0,8,0,10"/>
          <CheckBox x:Name="TeamResumeCheck" Content="이 마법사에서 만든 연구팀을 재설정 (이름·토큰·모델·설정 변경, 기록·메모리·세션 유지)" Margin="0,6,0,10"/>
          <CheckBox x:Name="MigrationConsent" Margin="0,0,0,10"><TextBlock Text="이전 4역할 연구팀(분배 서비스)이 있으면, 진행 중 작업이 끝난 뒤 그 서비스를 멈추고 설정을 백업한 다음 새 팀으로 바꾸는 데 동의합니다. 대화·산출물·기록은 지우지 않습니다." TextWrapping="Wrap"/></CheckBox>
          </StackPanel></Expander>
          <TextBox x:Name="TeamResult" Height="95" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" AutomationProperties.Name="연구팀 구성 결과"/>
